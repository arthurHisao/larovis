FROM php:8.3-fpm-alpine

# Instala extensões essenciais para o Laravel 13 e PostgreSQL
RUN apk add --no-cache nginx postgresql-dev libxml2-dev curl-dev libpng-dev \
    && docker-php-ext-install pdo_pgsql bcmath xml curl gd

# Baixa o Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Copia o código do backend
COPY . .

# Ajusta permissões de escrita do Laravel
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache

# Instala as dependências do Composer para produção
RUN composer install --no-dev --optimize-autoloader

# Configura um Nginx embutido simples de linha única para servir o Laravel
RUN echo 'server { listen 80; root /var/www/public; index index.php; location / { try_files $uri $uri/ /index.php?$query_string; } location ~ \.php$ { fastcgi_pass 127.0.0.1:9000; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; include fastcgi_params; } }' > /etc/nginx/http.d/default.conf

EXPOSE 80

# Inicializa o PHP-FPM e o Nginx juntos
CMD php-fpm -D && nginx -g "daemon off;"
