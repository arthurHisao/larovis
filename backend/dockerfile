# ------------------------------------
# Stage 1: Build & Compile Extensions
# ------------------------------------
FROM php:8.4-fpm-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    postgresql-dev \
    libxml2-dev \
    curl-dev \
    libpng-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    oniguruma-dev \
    && docker-php-ext-install pdo_pgsql bcmath xml curl gd zip mbstring

# Copy Composer from official image
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Copy application code
COPY . .

# Run Composer with strict memory flags suitable for Render free tier limits
ENV COMPOSER_MEMORY_LIMIT=512M
RUN composer install \
    --no-dev \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader \
    --no-interaction

# ------------------------------------
# Stage 2: Final Lightweight Image
# ------------------------------------
FROM php:8.4-fpm-alpine

# Install runtime libraries only
RUN apk add --no-cache \
    nginx \
    postgresql-libs \
    libpng \
    libzip \
    oniguruma

# Copy pre-compiled PHP extension binaries and configuration from Stage 1
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

WORKDIR /var/www

# Copy vendor dependencies and application code from Stage 1
COPY --from=builder /var/www /var/www

# Set appropriate permissions for Laravel storage and cache
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache

# Configure Nginx
RUN echo 'server { listen 80; root /var/www/public; index index.php; location / { try_files $uri $uri/ /index.php?$query_string; } location ~ \.php$ { fastcgi_pass 127.0.0.1:9000; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; include fastcgi_params; } }' > /etc/nginx/http.d/default.conf

EXPOSE 80

# Start PHP-FPM and Nginx
CMD php-fpm -D && nginx -g "daemon off;"
